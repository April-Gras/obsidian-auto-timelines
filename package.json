{
  "name": "obsidian-auto-timelines",
  "version": "0.14.1",
  "description": "This Obsidian (https://obsidian.md) plugin aims to simplify creating and maintaining timelines in different a project",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "coverage": "vitest --coverage",
    "dev": "vite build --watch --mode=development",
    "prepare-vitest": "node prepare-vitest.mjs",
    "test": "vitest",
    "test-ui": "vitest --ui --coverage",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "April",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^22.9.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.9",
    "builtin-modules": "5.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "happy-dom": "^20.10.6",
    "jiti": "^2.7.0",
    "lodash.clonedeep": "^4.5.0",
    "obsidian": "1.13.1",
    "prettier": "3.8.4",
    "sass": "~1.101.0",
    "ts-essentials": "^10.2.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8",
    "vitest": "^4.1.9",
    "vitest-mock-extended": "^4.0.0"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "lodash.isequal": "^4.5.0",
    "vue": "3.5.38",
    "vue-collapsed": "^1.3.5",
    "vue-feather": "^2.0.0",
    "vue-i18n": "^11.4.6",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.7.0"
}
