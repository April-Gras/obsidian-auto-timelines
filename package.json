{
  "name": "obsidian-auto-timelines",
  "version": "0.14.1",
  "description": "This Obsidian (https://obsidian.md) plugin aims to simplify creating and maintaining timelines in different a project",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "coverage": "vitest --coverage",
    "dev": "vite build --watch --mode=development",
    "prepare-vitest": "node prepare-vitest.mjs",
    "test": "vitest",
    "test-ui": "vitest --ui --coverage",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "April",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "^5.0.3",
    "builtin-modules": "5.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "lodash.clonedeep": "^4.5.0",
    "obsidian": "1.13.1",
    "prettier": "3.9.9",
    "sass": "~1.105.1",
    "ts-essentials": "^10.2.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vitest-mock-extended": "^5.1.1"
  },
  "dependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vue": "3.5.43",
    "vue-collapsed": "^1.3.5",
    "vue-feather": "^2.0.0",
    "vue-i18n": "^11.4.13",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.7.0"
}
